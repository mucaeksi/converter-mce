{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "converter-mce",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": { "APP_ENV": "production" },
  "d1_databases": [{
    "binding": "DB", "database_id": "3eafceff-08be-482a-b0d1-3902e0372d55",
    "database_name": "converter-mce",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "converter-mce-files" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "converter-mce-jobs" }],
    "consumers": [{
      "queue": "converter-mce-jobs",
      "max_batch_size": 1,
      "max_retries": 2,
      "max_concurrency": 2
    }]
  },
  "containers": [{
    "class_name": "ImageEngine",
    "image": "./Dockerfile",
    "max_instances": 2,
    "instance_type": "lite"
  }],
  "durable_objects": { "bindings": [{ "name": "ENGINE", "class_name": "ImageEngine" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImageEngine"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
